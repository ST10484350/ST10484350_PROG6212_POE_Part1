@model RaceDay.MVC.Models.EventViewModel
@using Microsoft.AspNetCore.Http
@using RaceDay.MVC.Models

@{
    ViewData["Title"] = Model.Title;
    var role = Context.Session.GetString("Role");
    var currentUserId = Context.Session.GetInt32("UserId");
    var categories = ViewBag.Categories as List<CategoryViewModel> ?? new List<CategoryViewModel>();
    var enrolledCategoryIds = ViewBag.EnrolledCategoryIds as HashSet<int> ?? new HashSet<int>();
}

<div class="row justify-content-center mt-4">
    <div class="col-md-9">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card shadow-sm mb-4">
            @* rendering the event banner from azure blob storage when available *@
            @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
            {
                <img src="@Model.BannerImageUrl" class="card-img-top" alt="@Model.Title" style="max-height: 350px; object-fit: cover;" />
            }
            else
            {
                <div class="bg-light d-flex align-items-center justify-content-center text-muted" style="height: 220px;">
                    <span>No Banner Image Uploaded</span>
                </div>
            }

            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h2 class="card-title mb-0">@Model.Title</h2>
                    <span class="badge bg-info text-dark text-uppercase fs-6">@Model.EventType</span>
                </div>

                <p class="lead">@Model.Description</p>

                <hr />

                <div class="row mb-4">
                    <div class="col-md-4">
                        <p class="mb-1 text-muted small">Date & Time</p>
                        <p class="fw-semibold">@Model.EventDate.ToString("dd MMM yyyy, HH:mm")</p>
                    </div>
                    <div class="col-md-4">
                        <p class="mb-1 text-muted small">Location</p>
                        <p class="fw-semibold">@Model.Location</p>
                    </div>
                    <div class="col-md-4">
                        <p class="mb-1 text-muted small">Distance</p>
                        <p class="fw-semibold">@Model.Distance km</p>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to Events</a>

                    @* showing organiser management actions only for the event owner *@
                    @if (role == "Organiser" && Model.OrganiserId == currentUserId)
                    {
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-outline-primary">Edit Event</a>
                            <form asp-action="Delete" asp-route-id="@Model.EventId" method="post" onsubmit="return confirm('Are you sure you want to delete this event?');">
                                <button type="submit" class="btn btn-outline-danger">Delete Event</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* displaying available race categories for this event *@
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Race Categories</h4>
                <span class="text-muted small">@categories.Count category(s) available</span>
            </div>
            <div class="card-body">
                @if (!categories.Any())
                {
                    <div class="alert alert-info mb-0">
                        No race categories have been added for this event yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Category</th>
                                    <th>Distance</th>
                                    <th>Entry Fee</th>
                                    @if (role == "Participant")
                                    {
                                        <th class="text-end">Action</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cat in categories)
                                {
                                    <tr>
                                        <td class="fw-semibold">@cat.CategoryName</td>
                                        <td>@cat.DistanceKm km</td>
                                        <td>R @cat.EntryFee.ToString("N2")</td>
                                        @if (role == "Participant")
                                        {
                                            <td class="text-end">
                                                @if (enrolledCategoryIds.Contains(cat.CategoryId))
                                                {
                                                    <span class="badge bg-success py-2 px-3">Already Enrolled</span>
                                                }
                                                else
                                                {
                                                    <form asp-controller="Enrolments" asp-action="Enrol" method="post" class="d-inline">
                                                        <input type="hidden" name="categoryId" value="@cat.CategoryId" />
                                                        <input type="hidden" name="eventId" value="@Model.EventId" />
                                                        <button type="submit" class="btn btn-sm btn-success">Enrol</button>
                                                    </form>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @* allowing the event owner to add new race categories *@
        @if (role == "Organiser" && Model.OrganiserId == currentUserId)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Add Race Category</h5>
                </div>
                <div class="card-body">
                    <form asp-action="AddCategory" method="post" class="row g-3">
                        <input type="hidden" name="EventId" value="@Model.EventId" />

                        <div class="col-md-5">
                            <label class="form-label">Category Name</label>
                            <input type="text" name="CategoryName" class="form-control" placeholder="e.g. Senior 10km" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Distance (km)</label>
                            <input type="number" step="0.1" min="0.1" name="DistanceKm" class="form-control" placeholder="10" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Entry Fee (R)</label>
                            <input type="number" step="0.01" min="0" name="EntryFee" class="form-control" placeholder="150" required />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">Add</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>