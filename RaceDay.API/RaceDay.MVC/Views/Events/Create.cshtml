@model RaceDay.MVC.Models.EventFormViewModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="card-title mb-4">Create a New Event</h2>

                @* using multipart/form-data so the optional banner image file is included in the post request *@
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Sandton Half Marathon" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the route, terrain, and race details..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="EventDate" class="form-label"></label>
                            <input asp-for="EventDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="EventDate" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" placeholder="e.g. Johannesburg" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Distance" class="form-label"></label>
                            <input asp-for="Distance" type="number" step="0.1" class="form-control" placeholder="e.g. 21.1" />
                            <span asp-validation-for="Distance" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="EventType" class="form-label"></label>
                            <select asp-for="EventType" class="form-select">
                                <option value="run">Run</option>
                                <option value="cycle">Cycle</option>
                                <option value="swim">Swim</option>
                                <option value="triathlon">Triathlon</option>
                            </select>
                            <span asp-validation-for="EventType" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="BannerImage" class="form-label"></label>
                        <input asp-for="BannerImage" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
                        <div class="form-text">Optional. Supported formats: JPG, PNG, WebP.</div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Create Event</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}